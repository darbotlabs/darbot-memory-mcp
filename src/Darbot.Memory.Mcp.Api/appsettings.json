{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5093"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "Darbot": {
    "Storage": {
      "Provider": "FileSystem",
      "BasePath": "./data",
      "FileSystem": {
        "RootPath": "./conversations"
      }
    },
    "FileNameTemplate": "%utc%_%conversationId%_%turn%.md",
    "HashAlgorithm": "SHA256",
    "Cors": {
      "AllowedOrigins": "*"
    },
    "Auth": {
      "Mode": "None"
    },
    "Mcp": {
      "MaxConcurrentClients": 10,
      "ConnectionTimeout": "00:01:00",
      "KeepAliveInterval": "00:00:30"
    },
    "BrowserHistory": {
      "Enabled": true,
      "SupportedBrowsers": "Edge",
      "SyncIntervalMinutes": 60,
      "MaxEntriesPerSync": 10000,
      "AutoSyncOnStartup": false,
      "IncludeProfiles": [],
      "ExcludeDomains": []
    },
    "Diagnostics": {
      "Otel": {
        "Exporter": "none"
      },
      "ApplicationInsights": {
        "Enabled": false
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/darbot-memory-mcp-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
