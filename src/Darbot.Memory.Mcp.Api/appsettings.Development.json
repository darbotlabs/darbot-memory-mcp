{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Darbot": "Debug"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5093"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 50,
      "MaxConcurrentUpgradedConnections": 50
    }
  },
  "Darbot": {
    "Storage": {
      "Provider": "FileSystem",
      "FileSystem": {
        "RootPath": "./data/conversations"
      }
    },
    "Mcp": {
      "MaxConcurrentClients": 10,
      "ConnectionTimeout": "00:01:00"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug"
  }
}
